# Copy to backend/.env. Every value here has a default; only the API key is needed for LLM steps.

# --- LLM --------------------------------------------------------------------------------
# Without credentials the app still runs: rule-based extraction and template explanations,
# labelled as such in the UI. Only text snippets of the synthetic data are sent to the API.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic            # anthropic | none
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT_EXTRACT=low            # extraction / explanation calls
LLM_EFFORT_ASK=medium             # the Ask agent's tool loop
LLM_REFUSAL_FALLBACK=default      # server-side refusal fallback (fallbacks="default"); set to off to disable
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_S=120

# --- Paths ------------------------------------------------------------------------------
DATA_DIR=../data                  # relative paths resolve from backend/; sources are found in any sub-folder
RUNS_DIR=runs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Knowledge base and readiness ---------------------------------------------------------
# The sources the agents read: initiatives (S1), GitHub repos (S4), team capacity (S5), team
# directory (S6), plus the service ownership map (S7) as a "who owns system X" lookup. Set to
# "all" to switch every source on.
ACTIVE_SOURCES=S1,S4,S5,S6,S7
# Only initiatives with one of these S1 statuses are analysed (Proposed / In Discovery are left out).
READY_STATUSES="Ready for PI Planning"

# --- Planning (T-shirt sizes against team capacity) ---------------------------------------
TSHIRT_POINTS=XS=3,S=5,M=8,L=13,XL=21,XXL=34   # story points per T-shirt size
DEFAULT_SIZE=M                    # assumed for an initiative with no size (and flagged)
SPRINTS_PER_PI=5                  # sprints in a quarter
PLAN_QUARTERS=4                   # quarter buckets on the decision dashboard (then "Later")
VELOCITY_TIERS=S=24,M=32,L=40     # a team's tier by story points per quarter; above the last is XL

# --- Budgets (exit behaviour: continue on the rule-based path, and say so) ---------------
# One extraction call per initiative plus re-queries and explanations: 90 covers every ready
# initiative of a PI (54 in the Haverstone data) in one run.
PIPELINE_MAX_MODEL_CALLS=90
ASK_MAX_MODEL_CALLS=6
ASK_MAX_CALLS_PER_TOOL=4
# Hidden dependencies only show across the whole set, so one run takes every ready initiative.
MAX_INITIATIVES_PER_RUN=60
MAX_UPLOAD_INITIATIVES=100

# --- Retrieval / verifier / rules (starting defaults: measure and replace) ---------------
CHUNK_CHARS=800
CHUNK_OVERLAP=120
RETRIEVAL_K=6
CONFIDENCE_THRESHOLD=0.6
MAX_REQUERY_ROUNDS=2
FUZZY_THRESHOLD=0.86
CAPACITY_WARN_PCT=100
CAPACITY_BLOCKER_PCT=130
HISTORY_MISS_RATIO=0.8
HISTORY_ESCALATE_SHARE=0.5

# Demo reviewer roster (role decides who may approve). JSON list of {id, name, role}.
# REVIEWERS_JSON=[{"id":"rte.presenter","name":"Presenter","role":"RTE"}]
